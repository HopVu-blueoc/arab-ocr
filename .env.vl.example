# Optional PaddleOCR-VL deployment overrides. Copy these values into .env,
# then start docker-compose.yml with docker-compose.paddle-vl.yml.
# The Compose overlay also supplies these values directly so the normal
# PaddleOCR defaults remain unchanged when the overlay is not selected.
OCR_ENGINE=paddle_vl
OCR_DEVICE=cpu
OCR_VL_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
OCR_VL_BACKEND=vllm-server
OCR_VL_SERVER_URL=http://paddleocr-vlm-server:8118/v1
OCR_VL_MAX_CONCURRENCY=1
OCR_VL_REQUEST_TIMEOUT_SECONDS=600
CELERY_WORKER_CONCURRENCY=1
