# Copy to .env to override. All values shown are the defaults.
DATA_DIR=data
REDIS_URL=redis://localhost:6379/0
JOB_BACKEND=celery          # inline | celery
REVIEWER_NAME=reviewer

# Docker/Celery worker processes. Keep the normal OCR default of 2; set 1
# when experimenting with PaddleOCR-VL so each prefork child does not load a
# second copy of the 0.9B model into GPU memory.
CELERY_WORKER_CONCURRENCY=2

# Where uploaded images go. local = a directory under DATA_DIR (default;
# needs nothing running). s3 = any S3-compatible store; on-prem that is
# RustFS, see docker-compose.yml.
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ocr-images
S3_REGION=us-east-1
# Placeholders. Put real credentials in .env, which is gitignored - this
# repository is public.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=CHANGE_ME

# Per-file upload cap, enforced while streaming.
MAX_UPLOAD_MB=25
# Cap on one whole multipart request; must stay <= nginx's client_max_body_size.
MAX_REQUEST_MB=100

# Recovery sweep for jobs stuck between DB commit and Celery publish, or
# stuck running past a worker crash Celery's own redelivery didn't catch.
RECONCILE_ENQUEUE_GRACE_SECONDS=30
RECONCILE_RUNNING_TIMEOUT_SECONDS=1800
RECONCILE_INTERVAL_SECONDS=60

# --- models ---
OCR_DEVICE=cpu

# paddle = default. paddle_vl = optional service-backed deployment; start it
# with docker-compose.paddle-vl.yml rather than changing only this value.
OCR_ENGINE=paddle
# OCR_ENGINE=paddle_vl
OCR_VL_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
OCR_VL_BACKEND=native
OCR_VL_SERVER_URL=
OCR_VL_MAX_CONCURRENCY=1
OCR_VL_REQUEST_TIMEOUT_SECONDS=600
OCR_REC_MODEL=arabic_PP-OCRv5_mobile_rec
OCR_DET_MODEL=PP-OCRv5_server_det     # accuracy first; ~10x slower on CPU than mobile_det
OCR_LATIN_REC_MODEL=latin_PP-OCRv5_mobile_rec

# --- detection: recall over precision (a review tool; a stray line is one click) ---
# Detection knobs: leave unset to use PaddleOCR's defaults. Tune per corpus
# with scripts/bench_ocr.py - there is no universally correct value.
# OCR_DET_LIMIT_SIDE_LEN=736
# OCR_DET_THRESH=0.3
# OCR_DET_BOX_THRESH=0.3
# OCR_DET_UNCLIP_RATIO=2.0

# --- recognition thresholds ---
OCR_PIPELINE_REC_SCORE_THRESH=0.0   # keep weak reads alive for the second pass
OCR_REC_SCORE_THRESH=0.3            # final gate, applied after the rescue
OCR_MIN_BOX_SIDE=0    # >0 deleted correctly-read small sign text

# --- orientation ---
OCR_USE_TEXTLINE_ORIENTATION=false   # measured: flipped a correct "510" into "OLS"
OCR_USE_DOC_ORIENTATION_CLASSIFY=false
OCR_USE_DOC_UNWARPING=false   # helps photographed documents, can distort scene photos

# --- second recognition pass (deskewed + upscaled crop, Arabic vs Latin) ---
OCR_SECOND_PASS=true
OCR_SECOND_PASS_MAX_SCORE=0.85   # only re-read lines at or below this
OCR_RESCUE_MIN_GAIN=0.15         # rescue must beat the pipeline by this to win
OCR_CROP_TARGET_HEIGHT=64
OCR_CROP_MAX_UPSCALE=4.0
OCR_CROP_CLAHE=true
